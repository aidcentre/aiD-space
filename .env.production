# Build-time public config for production deploys.
#
# These are read via $env/static/public, which Vite inlines into the client
# bundle at build time — they ship to every browser, so none of them are secret
# and committing them is deliberate. Doing so keeps the build identical locally,
# in CI, and on any clone, instead of depending on host-specific config that is
# invisible until it breaks (see the Azure SWA build failure this file fixes).
#
# Real secrets (SANITY_API_READ_TOKEN, BACKEND_API_KEY, PRIVATE_BACKEND_URL) are
# read at request time via $env/dynamic/private and belong in the host's
# application settings, never here.
#
# A local .env still wins for `npm run dev`.

PUBLIC_SANITY_PROJECT_ID=nkdafkhk
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-04-01
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
