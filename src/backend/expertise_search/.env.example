# Copy to .env and fill in. .env is gitignored — never commit it.
# In Azure these same names are set as Container App env vars / secrets.

# --- OpenAI ---
OPENAI_API_KEY=
# One model is used for every LLM call in the graph. Change it here rather than
# in clients.py — the strong/medium/weak client names are aliases now.
# OPENAI_MODEL=gpt-5.4-nano

# --- Shared secret the SvelteKit /chat proxy must send as X-API-Key ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank locally to disable auth.
BACKEND_API_KEY=

# --- Cosmos DB ---
# Portal: Cosmos account -> Settings -> Keys -> URI
COSMOS_ENDPOINT=https://<account-name>.documents.azure.com:443/
# Portal: Cosmos account -> Settings -> Keys -> PRIMARY KEY
# Leave blank in Azure to use the Container App's managed identity instead.
COSMOS_KEY=
COSMOS_DATABASE=ragdb
COSMOS_CHUNKS_CONTAINER=knowledgebase
COSMOS_DOCUMENTS_CONTAINER=documents
COSMOS_RESEARCHERS_CONTAINER=researchers

# --- Blob Storage ---
# Portal: Storage account -> Overview -> name (just the name, not the URL)
AZURE_STORAGE_ACCOUNT=
# Portal: Storage account -> Security + networking -> Access keys -> key1
# Leave blank in Azure to use managed identity.
AZURE_STORAGE_KEY=
AZURE_BLOB_CONTAINER=documents

# --- Retrieval tuning (optional; defaults shown) ---
# RETRIEVAL_TOP_K=60
# CONTEXT_DOCUMENTS=5
# Below this cosine similarity the backend says it found nothing rather than
# guessing. Measured on this corpus: on-topic 0.55-0.75, off-topic 0.17-0.25.
# MIN_SIMILARITY=0.4
# RRF_VECTOR_WEIGHT=2.0
# RRF_TEXT_WEIGHT=1.0
# MAX_HISTORY_TURNS=3
