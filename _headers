# Researcher headshots are content-stable (filename changes when a photo does),
# so let the CDN and browsers hold them for a year.
/images/researchers/*
  Cache-Control: public, max-age=31536000, immutable

# Article abstracts change only when the corpus is regenerated, and the file
# name is stable, so revalidate rather than cache forever.
/articles/*
  Cache-Control: public, max-age=3600, must-revalidate

/images/nodes/*
  Cache-Control: public, max-age=31536000, immutable
