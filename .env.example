# Match studio/.env (project ID + dataset). Add the frontend URL in Sanity Manage → API → CORS origins.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-04-01
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
PUBLIC_BASE_URL=http://localhost:5173

# Optional: Sanity API token with Viewer access for draft preview / visual editing.
SANITY_API_READ_TOKEN=

# URL of the expertise-search backend (aidspace_backend / FastAPI). Used by the
# /chat proxy route (src/routes/chat/+server.ts). Local default below; in
# production set this to the Azure Container App FQDN, with no trailing slash:
#   https://<app-name>.<region>.azurecontainerapps.io
PRIVATE_BACKEND_URL=http://127.0.0.1:8000

# Shared secret sent as the X-API-Key header to the backend. Must match
# BACKEND_API_KEY on the Container App. Server-side only — never PUBLIC_*.
# Leave blank when running the backend locally without auth.
BACKEND_API_KEY=