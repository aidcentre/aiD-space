# engine-strict is deliberately off. It was on from the initial commit, which
# meant a transitive dependency raising its Node requirement became a hard
# install failure rather than a warning — and that took the site down: the six
# Sanity packages are absent from package-lock.json, so npm re-resolves them on
# every build, and sanity@5.31.2 (2026-08-19) pulled in groq-js@2.0.0, which
# requires node >=22.12. See .nvmrc, which pins the Node this project expects.
engine-strict=false
